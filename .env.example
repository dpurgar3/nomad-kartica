# Wi-Fi za goste
WIFI_SSID=ASUS - NOMAd
WIFI_PASSWORD=

# Pravila kartice
POINTS_PER_RECEIPT=10
REWARD_POINTS=50
REWARD_NAME=Velika kava s mlijekom + kroasan
REWARD_VALID_DAYS=30
MAX_RECEIPTS_PER_DAY=1
# Račun se mora skenirati unutar ovoliko minuta od izdavanja (30 = pola sata)
RECEIPT_MAX_AGE_MINUTES=30
# Najmanji iznos računa za bodove, u centima (0 = bez ograničenja; npr. 200 = 2,00 €)
